# ============================================================
# SAGE Crop Disease Visual Diagnosis — .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/

# ----- Virtual Environments ---------------------------------
.env
.venv
env/
venv/
*.conda

# ----- Dataset (large binary files — store in GCS/Kaggle) ---
# Raw parquet files (download separately on Kaggle/GCP)
data/parquet/
# Old extraction pipeline artifacts (no longer needed)
data/processed/
SAGE-sample/

# ----- Model Weights & Training Outputs ---------------------
checkpoints/
outputs/
logs/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ----- GCP / Cloud Credentials ------------------------------
.gcloud/
*credentials*.json
*.gcloudignore

# ----- OS & IDE ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ----- Misc -------------------------------------------------
*.log
*.tmp
wandb/
