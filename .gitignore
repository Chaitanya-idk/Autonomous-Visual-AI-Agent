# ============================================================
# SAGE Crop Disease Visual Diagnosis — .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/

# ----- Virtual Environments ---------------------------------
.env
.venv
env/
venv/
*.conda

# ----- Dataset (NEVER commit — download on Kaggle/GCP) ------
data/processed/
data/parquet/
data/labels.json
SAGE-sample/

# Keep directory structure via .gitkeep
!data/.gitkeep

# ----- Model Weights & Training Outputs ---------------------
# checkpoints/, outputs/, logs/ are gitignored — keep .gitkeep only
checkpoints/*
!checkpoints/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep

# Also ignore any stray weight files
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ----- Pretrained model cache (downloaded locally) ----------
models/
hf_cache/

# ----- GCP / Cloud Credentials ------------------------------
.gcloud/
*credentials*.json
*.gcloudignore

# ----- OS & IDE ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ----- Misc -------------------------------------------------
*.log
*.tmp
wandb/
