# ============================================================
# SAGE QLoRA Project — .gitignore
# ============================================================

# ----- Python & Caching --------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
MANIFEST
pip-wheel-metadata/
.pytest_cache/
.coverage

# ----- Virtual Environments & Conda -------------------------
.env
.venv
env/
venv/
ENV/
*.conda

# ----- Jupyter Notebooks -------------------------------------
.ipynb_checkpoints/
*.ipynb

# ----- Dataset & Large Data Directories ----------------------
# Raw HuggingFace arrow dataset (original, read-only source)
SAGE-sample/

# Extracted images (regeneratable via src/extract_dataset.py)
data/processed/images/

# Generated CSVs and reports (regeneratable)
data/processed/metadata.csv
data/processed/train.csv
data/processed/val.csv
data/processed/test.csv
data/processed/labels.json
data/reports/

# ----- Model Artifacts, Weights & Training Outputs -----------
checkpoints/
outputs/
logs/
hf_cache/
.cache/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ----- GCP & Cloud Storage / Credentials ---------------------
.gcloud/
.gcp/
*.json-key
*credentials*.json
*.gcloudignore

# ----- Experiment Trackers & Logs ----------------------------
wandb/
runs/
tensorboard/
*.log

# ----- OS & IDE Files ----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
.gemini/

# ----- Miscellaneous -----------------------------------------
*.tmp
*.bak
*.orig
